{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conecta-canhotinho",
  "main": "src/index.ts", 
  "compatibility_date": "2026-01-01",
  
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "d1_databases": [
    {
      "binding": "DB", 
      "database_name": "meu-banco", 
      "database_id": "COLE_O_DATABASE_ID_AQUI" 
    }
  ],
  
  "observability": {
    "enabled": true
  }
}
