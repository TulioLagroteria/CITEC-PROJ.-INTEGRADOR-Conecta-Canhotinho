{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "WebWorker"], // WebWorker traz as tipagens nativas do Cloudflare Workers
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@cloudflare/workers-types"] // Injeta as tipagens do D1, KV, Env, etc.
  },
  "include": ["src/**/*"]
}
